{
  "name": "froggie-the-helper",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web -c green,cyan \"npm:dev:server\" \"npm:dev:web\"",
    "dev:web": "vite --host 127.0.0.1",
    "dev:server": "node --env-file-if-exists=.env --watch server/index.js",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "start": "node --env-file-if-exists=.env server/index.js"
  },
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "concurrently": "latest",
    "express": "latest",
    "vite": "latest",
    "typescript": "latest",
    "react": "latest",
    "react-dom": "latest",
    "lucide-react": "latest",
    "spectrum-ts": "latest"
  },
  "devDependencies": {}
}
