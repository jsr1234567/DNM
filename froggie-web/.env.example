# Photon Spectrum Cloud credentials from https://app.photon.codes
SPECTRUM_PROJECT_ID=
SPECTRUM_PROJECT_SECRET=

# Optional local API port
FROGGIE_API_PORT=8787

# Set on shared-line plans to add verified numbers to the Photon project before
# sending the setup code. Requires `photon login` for the local server process.
FROGGIE_SYNC_PHOTON_USERS=0

# Optional explicit auto-approval into an existing, operator-curated local circle.
# Leave unset to create paused users that require `bun run users:approve`.
FROGGIE_TRUSTED_CIRCLE_ID=
